# Telegram Bot
BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=000000000

# Payment Gateway (Meldapay)
PAYMENT_BASE_URL=https://meldapay.com
PAYMENT_API_KEY=your-meldapay-api-key

# Supabase (service role key — keep secret, server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Optional
# LOG_CHANNEL=@your_channel
# RECEIPT_IMAGE_PATH=assets/receipt.jpg
# LOG_LEVEL=info      # debug | info | warn | error
# NODE_ENV=production
# NO_COLOR=1          # plain log output
